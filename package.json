{
  "name": "far-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:layout-v2 && vite",
    "web:dev": "bun run build:layout-v2 && vite --host 127.0.0.1 --port 4173 --strictPort",
    "build:layout-v2": "bun scripts/build-local-layout-v2.mjs",
    "build": "bun run build:layout-v2 && tsc && vite build",
    "preview": "vite preview",
    "test": "bun run build:layout-v2 && vitest run",
    "test:ci:unit": "bun run build:layout-v2 && vitest run",
    "test:playwright:install": "bunx playwright install --with-deps chromium",
    "test:e2e:ci": "bunx playwright test --reporter=line",
    "check:architecture": "bun scripts/check-architecture-guards.mjs",
    "check:guards": "bun run check:architecture",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "layout-v2": "file:../layout-v2",
    "lucide-react": "^1.8.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  },
  "trustedDependencies": [
    "layout-v2"
  ]
}
